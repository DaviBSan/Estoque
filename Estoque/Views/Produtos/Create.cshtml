@model Estoque.Models.Produto

<div class="card" style="max-width:600px">
    <div class="page-header">
        <h1 class="page-title">Novo Produto</h1>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.Nome)
            @Html.TextBoxFor(m => m.Nome, new { @class = "form-control", placeholder = "Ex: Camiseta Básica" })
            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Descricao)
            @Html.TextBoxFor(m => m.Descricao, new { @class = "form-control", placeholder = "Descrição do produto" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Preco)
            @Html.TextBoxFor(m => m.Preco, new { @class = "form-control", placeholder = "0,00" })
            @Html.ValidationMessageFor(m => m.Preco, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Genero)
            @Html.DropDownListFor(m => m.Genero, new SelectList(new[] { "Masculino", "Feminino", "Unissex" }), "Selecione...", new { @class = "form-control" })
        </div>

        <div style="display:flex; gap:10px; margin-top:1.5rem">
            <button type="submit" class="btn btn-primary">Salvar Produto</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>